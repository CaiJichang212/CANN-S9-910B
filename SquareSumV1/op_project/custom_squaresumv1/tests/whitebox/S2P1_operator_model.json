  "shape_mapping": {
    "dtype": {
      "param": "dtype",
      "values": [
        "float16",
        "bfloat16",
        "float"
      ]
    },
    "shape_params": {
      "totalRows": {
        "role": "leading_product",
        "type": "int",
        "default": 1
      },
      "rLength": {
        "role": "trailing_size",
        "type": "int"
      },
      "a0Length": {
        "role": "trailing_size",
        "type": "int",
        "default": 1,
        "group_defaults": {
          "G0": 1,
          "G1": 1,
          "G2": 1,
          "G5": 1
        }
      },
      "keep_dims": {
        "role": "other",
        "type": "bool",
        "default": false
      }
    },
    "ndim": {
      "source": "random",
      "range": [
        3,
        4
      ],
      "tensor_constraints": {
        "input": [
          {
            "when": "_group == 'G0'",
            "min": 3,
            "max": 3
          },
          {
            "when": "_group == 'G1'",
            "min": 3,
            "max": 3
          },
          {
            "when": "_group == 'G2'",
            "min": 3,
            "max": 3
          },
          {
            "when": "_group == 'G3'",
            "min": 3,
            "max": 3
          },
          {
            "when": "_group == 'G4'",
            "min": 3,
            "max": 3
          },
          {
            "when": "_group == 'G5'",
            "min": 4,
            "max": 4
          }
        ]
      }
    },
    "inputs": {
      "input": {
        "rule": "decompose",
        "decompose": {
          "leading": {
            "param": "totalRows",
            "strategy": "balanced"
          },
          "trailing": [
            {
              "param": "rLength"
            },
            {
              "param": "a0Length"
            }
          ],
          "parts_expr": "ndim - len(trailing)"
        }
      }
    },
    "outputs": {
      "result": {
        "rule": "derived",
        "derived": {
          "expr": "input.shape[:-2] + input.shape[-1:]"
        }
      }
    },
    "attrs": {
      "keep_dims": {
        "param": "keep_dims",
        "type": "bool"
      }
    }
  }
