      "source": "squaresumv1_def.cpp:38-40",
      "sampling_hint": "choice"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "dtype": {
        "sync_with": "input"
      },
      "shape": {
        "rule": "derived",
        "expr": "output_shape = input.shape with reduced axes removed (keep_dims=false) or set to 1 (keep_dims=true); output tensor is pre-allocated by the caller based on torch.sum(torch.square(x), axis, keepdim=keep_dims).shape; InferShape copies inputShape to outputShape but the actual shape is determined by the framework before kernel invocation",
        "source": "squaresumv1_infershape.cpp:30, test_op.py:69-72"
      }
    }
  ],
