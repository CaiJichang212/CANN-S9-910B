# metadata：仅保留 sha256/runtime_env/package_contents（小且不可重建），
# 忽略 profiling 原始日志与被否决/废弃的 latency 副产物目录
Concat/perf_eval/20260728_p0/metadata/*_profile.log
Concat/perf_eval/20260728_p0/metadata/p0_ld_debug.txt
Concat/perf_eval/20260728_p0/metadata/partial_independent_latency/
Concat/perf_eval/20260728_p0/metadata/rejected_latency_*/
Concat/perf_eval/20260728_p0/metadata/stray_build_install_path/

# 例外：correctness/*.log 是小里程碑基线（报告显式引用），保留跟踪
!Concat/perf_eval/20260728_p0/correctness/*.log

