+++ b/SquareSumV1/op_project/custom_squaresumv1/op_host/square_sum_v1_tiling.cpp
@@ -889,6 +889,7 @@ static ge::graphStatus SquareSumV1TilingFunc(gert::TilingContext* context)
     int64_t numA0Tiles = 1;
     int64_t rChunkSize = 0;
     int64_t numRChunks = 0;
+    bool araRetiledForCoreParallelism = false;
     uint32_t reduceTmpBytes = 0;
     int64_t cooperativeCoreNum = 0;
     size_t workspaceSize = WS_SYS_SIZE;
@@ -1155,8 +1156,56 @@ static ge::graphStatus SquareSumV1TilingFunc(gert::TilingContext* context)
                 tileA0Len = targetLen;
                 tileA0Align = targetLen;
                 numA0Tiles = CeilDiv(a0Length, tileA0Len);
+                araRetiledForCoreParallelism = true;
             }
         }
+
+        // Row-split initially sizes R against the wider pre-parallelism A0
+        // tile.  If A0 was narrowed to expose independent output owners,
+        // recompute R with the final tile and the exact buffers allocated by
+        // the mode-3 kernel.  Unretiled mode-3 and all other modes retain
+        // their existing tiling.
+        if (tilingMode == 3 && araRetiledForCoreParallelism) {
+            auto computeFinalRowSplitUbNeeded = [&](int64_t rRows, int64_t cols) -> uint64_t {
+                const uint64_t matrixElems = static_cast<uint64_t>(rRows) * cols;
+                const uint64_t inBytes = matrixElems * typeSize;
+                const uint64_t computeBytes = (dataType == ge::DT_FLOAT)
+                    ? 0 : matrixElems * sizeof(float);
+                const uint64_t accBytes = static_cast<uint64_t>(cols) * sizeof(float);
+                const uint64_t reduceBytes = static_cast<uint64_t>(cols) * sizeof(float);
+                const uint64_t outBytes = static_cast<uint64_t>(cols) * typeSize;
+
+                ge::Shape reduceShape({rRows, cols});
+                uint32_t maxTmpBytes = 0;
+                uint32_t minTmpBytes = 0;
+                AscendC::GetReduceSumMaxMinTmpSize(
+                    reduceShape, ge::DT_FLOAT, AscendC::ReducePattern::RA,
+                    true, true, maxTmpBytes, minTmpBytes);
+                const uint64_t tmpBytes = std::max(maxTmpBytes, static_cast<uint32_t>(32));
+                return inBytes + computeBytes + accBytes + reduceBytes + outBytes + tmpBytes;
+            };
+
+            int64_t minRChunk = 1;
+            int64_t maxRChunk = std::min(rLength, MAX_DMA_BLOCK_COUNT);
+            int64_t bestRChunk = 1;
+            while (minRChunk <= maxRChunk) {
+                const int64_t mid = (minRChunk + maxRChunk) / 2;
+                if (computeFinalRowSplitUbNeeded(mid, tileA0Align) <= ubSize) {
+                    bestRChunk = mid;
+                    minRChunk = mid + 1;
+                } else {
+                    maxRChunk = mid - 1;
+                }
+            }
+            rChunkSize = bestRChunk;
+            numRChunks = CeilDiv(rLength, rChunkSize);
+
+            ge::Shape finalReduceShape({rChunkSize, tileA0Align});
+            uint32_t minTmpBytes = 0;
+            AscendC::GetReduceSumMaxMinTmpSize(
+                finalReduceShape, ge::DT_FLOAT, AscendC::ReducePattern::RA,
+                true, true, reduceTmpBytes, minTmpBytes);
+        }
     }
 
