+static uint64_t SaturatingAdd(uint64_t lhs, uint64_t rhs)
+{
+    if (rhs > std::numeric_limits<uint64_t>::max() - lhs) {
+        return std::numeric_limits<uint64_t>::max();
+    }
+    return lhs + rhs;
+}
+
+static uint64_t SaturatingMul(uint64_t lhs, uint64_t rhs)
+{
+    if (lhs != 0 && rhs > std::numeric_limits<uint64_t>::max() / lhs) {
+        return std::numeric_limits<uint64_t>::max();
+    }
+    return lhs * rhs;
+}
+
+struct ColumnMetrics {
+    uint64_t submitTiles = 0;
+    uint64_t fragmentIntersections = 0;
+    uint64_t ubStagingBytes = 0;
+    uint64_t worstCoreSubmitTiles = 0;
+};
+
+struct BoundaryPlan {
+    bool valid = false;
+    uint32_t colBoundaryBytes[MAX_CONCAT_BOUNDARY_NUM] = {0};
+    uint64_t worstCost = std::numeric_limits<uint64_t>::max();
+    ColumnMetrics metrics;
+};
+
+static bool AddMetric(uint64_t delta, uint64_t &total)
+{
+    total = SaturatingAdd(total, delta);
+    return total != std::numeric_limits<uint64_t>::max();
+}
+
+static uint64_t EstimateWholeFragmentSubmitTiles(uint32_t rows, uint64_t pieceBytes)
+{
+    if (pieceBytes == 0) return 0;
+    if (pieceBytes > TILE_BYTES) {
+        return SaturatingMul(rows, CeilDiv64(pieceBytes, TILE_BYTES));
+    }
+    const uint64_t alignedPieceBytes = AlignUp(pieceBytes, DATA_BLOCK_BYTES);
+    const uint64_t rowsPerTile = std::min<uint64_t>(TILE_BYTES / alignedPieceBytes,
+                                                    MAX_COPY_BLOCK_COUNT);
+    return rowsPerTile == 0 ? std::numeric_limits<uint64_t>::max() :
+                              CeilDiv64(rows, rowsPerTile);
+}
+
+static bool ModelColumnPlan(uint32_t beforeDimSize, uint32_t rowSliceNum, uint32_t colCoreNum,
+                            uint64_t rowBytes, uint32_t inputNum, const uint32_t *inputCatLen,
+                            const uint32_t *inputCatOffset, uint64_t catUnitBytes,
+                            const uint32_t *colBoundaryBytes, ColumnMetrics &metrics)
+{
+    if (rowSliceNum == 0 || colCoreNum == 0 || colBoundaryBytes[0] != 0 ||
+        colBoundaryBytes[colCoreNum] != rowBytes) {
+        return false;
+    }
+    for (uint32_t col = 0; col < colCoreNum; ++col) {
+        if (colBoundaryBytes[col] >= colBoundaryBytes[col + 1]) return false;
+    }
+
+    for (uint32_t rowSlice = 0; rowSlice < rowSliceNum; ++rowSlice) {
+        const uint64_t startRow64 = static_cast<uint64_t>(beforeDimSize) * rowSlice / rowSliceNum;
+        const uint64_t endRow64 = static_cast<uint64_t>(beforeDimSize) * (rowSlice + 1) / rowSliceNum;
+        const uint64_t rows = endRow64 - startRow64;
+        if (rows == 0) continue;
+        for (uint32_t col = 0; col < colCoreNum; ++col) {
+            uint64_t coreSubmitTiles = 0;
+            const uint64_t colBegin = colBoundaryBytes[col];
+            const uint64_t colEnd = colBoundaryBytes[col + 1];
+            for (uint32_t input = 0; input < inputNum; ++input) {
+                const uint64_t inputBegin = static_cast<uint64_t>(inputCatOffset[input]) * catUnitBytes;
+                const uint64_t inputRowBytes = static_cast<uint64_t>(inputCatLen[input]) * catUnitBytes;
+                const uint64_t inputEnd = inputBegin + inputRowBytes;
+                const uint64_t begin = std::max(inputBegin, colBegin);
+                const uint64_t end = std::min(inputEnd, colEnd);
+                if (begin >= end || inputRowBytes == 0) continue;
+
+                const uint64_t pieceBytes = end - begin;
+                if (!AddMetric(1, metrics.fragmentIntersections)) return false;
+                if (pieceBytes > TILE_BYTES) {
+                    const uint64_t tilesPerRow = CeilDiv64(pieceBytes, TILE_BYTES);
+                    const uint64_t tileCount = SaturatingMul(rows, tilesPerRow);
+                    if (!AddMetric(tileCount, metrics.submitTiles) ||
+                        !AddMetric(tileCount, coreSubmitTiles)) return false;
+                    const uint64_t fullTiles = pieceBytes / TILE_BYTES;
+                    const uint64_t tailBytes = pieceBytes % TILE_BYTES;
+                    const uint64_t stagingPerRow = SaturatingAdd(
+                        SaturatingMul(fullTiles, TILE_BYTES),
+                        tailBytes == 0 ? 0 : AlignUp(tailBytes, DATA_BLOCK_BYTES));
+                    if (!AddMetric(SaturatingMul(rows, stagingPerRow), metrics.ubStagingBytes)) return false;
+                    continue;
+                }
+
+                const uint64_t alignedPieceBytes = AlignUp(pieceBytes, DATA_BLOCK_BYTES);
+                const uint64_t rowsByTile = TILE_BYTES / alignedPieceBytes;
+                const uint64_t rowsPerTile = std::min<uint64_t>(rowsByTile, MAX_COPY_BLOCK_COUNT);
+                const uint64_t tileCount = rowsPerTile == 0 ? 0 : CeilDiv64(rows, rowsPerTile);
+                if (rowsPerTile == 0 || !AddMetric(tileCount, metrics.submitTiles) ||
+                    !AddMetric(tileCount, coreSubmitTiles) ||
+                    !AddMetric(SaturatingMul(rows, alignedPieceBytes), metrics.ubStagingBytes)) {
+                    return false;
+                }
+            }
+            metrics.worstCoreSubmitTiles = std::max(metrics.worstCoreSubmitTiles, coreSubmitTiles);
+        }
+    }
+    return true;
+}
+
+static BoundaryPlan ChooseBoundaryPlan(const SplitChoice &parent, uint32_t beforeDimSize,
+                                       uint64_t rowBytes, uint32_t inputNum,
+                                       const uint32_t *inputCatLen, const uint32_t *inputCatOffset,
+                                       uint64_t catUnitBytes)
+{
+    BoundaryPlan plan;
+    if (inputNum < 64 || parent.splitMode != 1 || rowBytes == 0 ||
+        rowBytes > UINT32_MAX || (rowBytes % DATA_BLOCK_BYTES) != 0 ||
+        parent.colCoreNum < 2 || parent.colCoreNum > MAX_CONCAT_INPUT_NUM ||
+        static_cast<uint64_t>(parent.rowSliceNum) * parent.colCoreNum != parent.usedCoreNum) {
+        return plan;
+    }
+
+    const uint32_t maxRows = CeilDiv(beforeDimSize, parent.rowSliceNum);
+    std::vector<uint32_t> eligibleBytes;
+    std::vector<uint64_t> eligibleCosts;
+    eligibleBytes.reserve(MAX_CONCAT_BOUNDARY_NUM);
+    eligibleCosts.reserve(MAX_CONCAT_BOUNDARY_NUM);
+    eligibleBytes.push_back(0);
+    eligibleCosts.push_back(0);
+
+    uint64_t prefixCost = 0;
+    for (uint32_t input = 0; input < inputNum; ++input) {
+        uint64_t pieceBytes = 0;
+        uint64_t boundaryBytes = 0;
+        const uint64_t inputEnd = static_cast<uint64_t>(inputCatOffset[input]) + inputCatLen[input];
+        if (!CheckedMul(inputCatLen[input], catUnitBytes, pieceBytes) ||
+            !CheckedMul(inputEnd, catUnitBytes, boundaryBytes)) {
+            return plan;
+        }
+        prefixCost = SaturatingAdd(prefixCost,
+                                   EstimateWholeFragmentSubmitTiles(maxRows, pieceBytes));
+        if (prefixCost == std::numeric_limits<uint64_t>::max()) return plan;
+        if ((boundaryBytes % DATA_BLOCK_BYTES) == 0 && boundaryBytes != eligibleBytes.back()) {
+            if (boundaryBytes > UINT32_MAX) return plan;
+            eligibleBytes.push_back(static_cast<uint32_t>(boundaryBytes));
+            eligibleCosts.push_back(prefixCost);
+        }
+    }
+
+    const uint32_t columnCount = parent.colCoreNum;
+    if (eligibleBytes.size() < static_cast<size_t>(columnCount + 1) ||
+        eligibleBytes.back() != rowBytes) {
+        return plan;
+    }
+
+    const uint64_t infinity = std::numeric_limits<uint64_t>::max();
+    const uint16_t invalidIndex = std::numeric_limits<uint16_t>::max();
+    const size_t stateCount = eligibleBytes.size();
+    std::vector<uint64_t> previous(stateCount, infinity);
+    std::vector<uint64_t> current(stateCount, infinity);
+    std::vector<uint16_t> predecessor(static_cast<size_t>(columnCount + 1) * stateCount,
+                                      invalidIndex);
+    previous[0] = 0;
+    for (uint32_t part = 1; part <= columnCount; ++part) {
+        std::fill(current.begin(), current.end(), infinity);
+        for (size_t end = part; end < stateCount; ++end) {
+            uint16_t bestBegin = invalidIndex;
+            uint64_t bestCost = infinity;
+            for (size_t begin = part - 1; begin < end; ++begin) {
+                if (previous[begin] == infinity) continue;
+                const uint64_t segmentCost = eligibleCosts[end] - eligibleCosts[begin];
+                const uint64_t candidateCost = std::max(previous[begin], segmentCost);
+                if (candidateCost < bestCost ||
+                    (candidateCost == bestCost && begin < bestBegin)) {
+                    bestCost = candidateCost;
+                    bestBegin = static_cast<uint16_t>(begin);
+                }
+            }
+            current[end] = bestCost;
+            predecessor[static_cast<size_t>(part) * stateCount + end] = bestBegin;
+        }
+        previous.swap(current);
+    }
+    if (previous.back() == infinity) return plan;
+
+    size_t end = stateCount - 1;
+    plan.colBoundaryBytes[columnCount] = static_cast<uint32_t>(rowBytes);
+    for (uint32_t part = columnCount; part > 0; --part) {
+        const uint16_t begin = predecessor[static_cast<size_t>(part) * stateCount + end];
+        if (begin == invalidIndex || begin >= end) return BoundaryPlan{};
+        plan.colBoundaryBytes[part - 1] = eligibleBytes[begin];
+        end = begin;
+    }
+    if (end != 0) return BoundaryPlan{};
+
+    uint32_t parentBoundaries[MAX_CONCAT_BOUNDARY_NUM] = {0};
+    for (uint32_t col = 0; col <= columnCount; ++col) {
+        const uint64_t boundary = static_cast<uint64_t>(col) * parent.colBlockBytes;
+        parentBoundaries[col] = static_cast<uint32_t>(std::min<uint64_t>(rowBytes, boundary));
+    }
+
+    ColumnMetrics parentMetrics;
+    if (!ModelColumnPlan(beforeDimSize, parent.rowSliceNum, columnCount, rowBytes, inputNum,
+                         inputCatLen, inputCatOffset, catUnitBytes, parentBoundaries, parentMetrics) ||
+        !ModelColumnPlan(beforeDimSize, parent.rowSliceNum, columnCount, rowBytes, inputNum,
+                         inputCatLen, inputCatOffset, catUnitBytes, plan.colBoundaryBytes, plan.metrics) ||
+        previous.back() > parentMetrics.worstCoreSubmitTiles ||
+        plan.metrics.submitTiles >= parentMetrics.submitTiles ||
+        plan.metrics.fragmentIntersections > parentMetrics.fragmentIntersections ||
+        plan.metrics.ubStagingBytes > parentMetrics.ubStagingBytes) {
+        return BoundaryPlan{};
+    }
+
+    plan.worstCost = previous.back();
+    plan.valid = true;
+    return plan;
+}
